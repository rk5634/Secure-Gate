# syntax=docker/dockerfile:1

# Base image with Go and Air
FROM golang:1.24

# Set working directory
WORKDIR /app

# Install Air for live reload
RUN go install github.com/air-verse/air@latest

# Copy go mod and sum first, then download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source code (optional if using bind mount in docker-compose)
COPY . .

# Expose port
EXPOSE 8080

# Default command (Air will handle rebuild & rerun)
CMD ["air"]
